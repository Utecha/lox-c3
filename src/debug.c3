module lox::debug @feat(DEBUG);
import lox::lexer;
import lox::opcode;
import lox::token;
import lox::value;
import std::io @norecurse;

//------------------------------------------------------------------------------

// Configurable flags for enabling/disabling certain internal debugging features.
const bool DUMP_CODE        = false;
const bool DUMP_STACK       = false;
const bool DUMP_TOKENS      = false;
const bool TRACE_EXECUTION  = false;

//------------------------------------------------------------------------------

<*
    Disassembles the bytecode for an entire [fun] object, dumping it to the
    standard output.

    @param [&inout] fun : "A pointer to an ObjFun."
    @param name : "The name of the function."
*>
fn void disassemble(ObjFun *fun, String name)
{
    io::printfn("[ %s ]", name);

    for (sz offset = 0; offset < fun.code.len();)
    {
        offset = dump_instruction(fun, offset);
    }

    io::printn();
}

<*
    Dumps a single instruction of bytecode found in [fun] at [offset]
    to the standard output.

    @param [&inout] fun : "A pointer to an ObjFun."
    @param offset : "The bytecode offset of the instruction."
*>
fn sz dump_instruction(ObjFun *fun, sz offset)
{
    OpCode instruction = (OpCode)fun.code[offset];
    int line = value::get_line(fun, offset);

    if (offset > 0 && line == value::get_line(fun, offset - 1))
    {
        io::print("     ");
    }
    else
    {
        io::printf("%4d:", line);
    }

    io::printf(" %04d  ", offset);
    switch (instruction)
    {
        case NIL:
        case FALSE:
        case TRUE:
        case POP:
        case NEGATE:
        case NOT:
        case ADD:
        case SUB:
        case MUL:
        case DIV:
        case MOD:
        case GREATER:
        case LESS:
        case EQUAL:
        case RETURN:
            return simple_instruction(instruction.name, offset);

        case CONSTANT:
            return constant_instruction(instruction.name, fun, offset);

        case JUMP:
        case JUMP_IF:
        case AND:
        case OR:
            return jump_instruction(instruction.name, fun, 1, offset);

        case LOOP:
            return jump_instruction(instruction.name, fun, -1, offset);

        default:
            io::printfn("Missing: '%s'", instruction.name);
            return offset + 1;
    }
}

<*
    Dumps the current state of the stack to the standard output.

    @param [&inout] vm : "A pointer to a LoxVM."
*>
fn void dump_stack(LoxVM *vm)
{
    io::printf("[ LoxVM %p ]", vm);

    for (Value *slot = vm.stack; slot < vm.stack_top; slot++)
    {
        io::print("[ ");
        value::print(*slot);
        io::print(" ]");
    }

    io::printn();
}

<*
    Dumps the tokens generated by [l] to the standard output.

    @param [&inout] l : "A pointer to a Lexer."
*>
fn void dump_tokens(LoxLexer *l)
{
    for (;;)
    {
        Token t = lexer::next(l);
        io::print(t);

        if (t.type == EOF) break;
    }

    io::printn();
}

//------------------------------------------------------------------------------

fn sz constant_instruction(String name, ObjFun *fun, sz offset) @inline @local
{
    ushort constant = (ushort)(fun.code[offset + 1] << 8);
    constant |= (ushort)fun.code[offset + 2];

    io::printf("%-16s %5d '", name, constant);
    value::print(fun.constants[constant]);
    io::printn("'");

    return offset + 3;
}

fn sz jump_instruction(String name, ObjFun *fun, sz sign, sz offset) @inline @local
{
    ushort jump = (ushort)(fun.code[offset + 1] << 8);
    jump |= (ushort)fun.code[offset + 2];

    io::printfn("%-16s %5d -> %d", name, jump, offset + 3 + sign * jump);

    return offset + 3;
}

fn sz simple_instruction(String name, sz offset) @inline @local
{
    io::printn(name);
    return offset + 1;
}
